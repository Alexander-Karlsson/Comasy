@model Comasy.Web.Models.ContentBlockFormViewModel

<input type="hidden" asp-for="Id" />
<input type="hidden" asp-for="PageId" />

<div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

<div class="mb-4">
    <label asp-for="BlockType" class="form-label"></label>
    <select asp-for="BlockType" class="form-select" id="blockTypeSelect">
        <option value="@((int)BlockType.Heading)" data-name="Heading">Rubrik</option>
        <option value="@((int)BlockType.Text)" data-name="Text">Text</option>
        <option value="@((int)BlockType.Image)" data-name="Image">Bild</option>
        <option value="@((int)BlockType.Link)" data-name="Link">Länk</option>
    </select>
</div>

<div class="mb-3" data-types="Heading Text">
    <label asp-for="Text" class="form-label"></label>
    <textarea asp-for="Text" class="form-control" rows="6"></textarea>
    <span asp-validation-for="Text" class="text-danger"></span>
</div>

<div class="mb-3" data-types="Image">
    <label asp-for="ImageUrl" class="form-label"></label>
    <input asp-for="ImageUrl" class="form-control" placeholder="https://..." />
    <span asp-validation-for="ImageUrl" class="text-danger"></span>
</div>

<div class="mb-3" data-types="Image">
    <label asp-for="AltText" class="form-label"></label>
    <input asp-for="AltText" class="form-control" />
    <span asp-validation-for="AltText" class="text-danger"></span>
    <div class="form-text">
        Beskriv bilden för den som använder skärmläsare eller har bilder avstängda.
    </div>
</div>

<div class="mb-3" data-types="Link">
    <label asp-for="LinkUrl" class="form-label"></label>
    <input asp-for="LinkUrl" class="form-control" placeholder="/om-systemet eller https://..." />
    <span asp-validation-for="LinkUrl" class="text-danger"></span>
</div>

<div class="mb-3" data-types="Link">
    <label asp-for="LinkText" class="form-label"></label>
    <input asp-for="LinkText" class="form-control" />
    <span asp-validation-for="LinkText" class="text-danger"></span>
</div>