@model List<Comasy.Web.Models.PageListItemViewModel>

@{
    ViewData["Title"] = "Sidor";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="mb-0">Sidor</h1>
    <a class="btn btn-primary" asp-action="Create">Ny sida</a>
</div>

@if (!Model.Any())
{
    <div class="alert alert-info">
        Inga sidor ännu. Skapa den första med knappen ovan.
    </div>
}
else
{
    <div class="table-responsive">
        <table class="table table-hover align-middle">
            <thead>
            <tr>
                <th>Titel</th>
                <th>Webbadress</th>
                <th>Status</th>
                <th>Skapad</th>
                <th class="text-end">Åtgärder</th>
            </tr>
            </thead>
            <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.Title</td>
                    <td><code>/@item.Slug</code></td>
                    <td>
                        @if (item.IsPublished)
                        {
                            <span class="badge text-bg-success">Publicerad</span>
                        }
                        else
                        {
                            <span class="badge text-bg-secondary">Utkast</span>
                        }
                    </td>
                    <td>@item.CreatedAt.ToLocalTime().ToString("yyyy-MM-dd")</td>
                    <td class="text-end">
                        <div class="btn-group btn-group-sm">
                            @if (item.IsPublished)
                            {
                                <a class="btn btn-outline-secondary"
                                   asp-area="" asp-controller="Page" asp-action="Index"
                                   asp-route-slug="@item.Slug" target="_blank">Visa</a>
                            }
                            <a class="btn btn-outline-primary"
                               asp-action="Edit" asp-route-id="@item.Id">Redigera</a>
                            <form asp-action="Delete" asp-route-id="@item.Id" method="post">
                                <button type="submit" class="btn btn-outline-danger"
                                        onclick="return confirm('Radera sidan? Allt innehåll och eventuella menyposter försvinner.');">
                                    Radera
                                </button>
                            </form>
                        </div>
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
}