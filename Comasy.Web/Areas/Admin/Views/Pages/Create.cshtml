@model Comasy.Web.Models.CreatePageViewModel

@{
    ViewData["Title"] = "Ny sida";
}

<div class="row">
    <div class="col-md-6">
        <h1 class="mb-4">Ny sida</h1>

        <form asp-action="Create" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <div class="mb-3">
                <label asp-for="Title" class="form-label"></label>
                <input asp-for="Title" class="form-control" autofocus />
                <span asp-validation-for="Title" class="text-danger"></span>
                <div class="form-text">
                    Webbadressen skapas automatiskt från titeln och går inte att ändra efteråt.
                </div>
            </div>

            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-primary">Skapa</button>
                <a class="btn btn-outline-secondary" asp-action="Index">Avbryt</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}