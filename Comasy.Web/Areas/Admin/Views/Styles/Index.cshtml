@model List<Comasy.Web.Models.SiteStyleFormViewModel>

@{
    ViewData["Title"] = "Utseende";
}

<h1 class="mb-1">Utseende</h1>
<p class="text-muted mb-4">
    Inställningarna gäller allt innehåll på sajten, oavsett vilken sida det ligger på.
</p>

<div class="list-group">
    @foreach (var item in Model)
    {
        <div class="list-group-item d-flex justify-content-between align-items-center">
            <div>
                <div class="fw-semibold">@item.ElementName</div>
                <div class="text-muted small">
                    @{
                        var parts = new List<string>();
                        if (!string.IsNullOrWhiteSpace(item.FontFamily)) parts.Add(item.FontFamily);
                        if (!string.IsNullOrWhiteSpace(item.FontSize)) parts.Add(item.FontSize);
                        if (!string.IsNullOrWhiteSpace(item.Color)) parts.Add(item.Color);
                    }
                    @(parts.Count > 0 ? string.Join(" · ", parts) : "Standardutseende")
                </div>
            </div>
            <a class="btn btn-sm btn-outline-primary"
               asp-action="Edit" asp-route-element="@item.Element">Ändra</a>
        </div>
    }
</div>