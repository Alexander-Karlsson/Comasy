@model Comasy.Web.Models.MenuItemFormViewModel

@{
    ViewData["Title"] = "Redigera menyalternativ";
}

<h1 class="mb-4">Redigera menyalternativ</h1>

<div class="row">
    <div class="col-md-6">
        <form asp-action="Edit" method="post">
            <partial name="_MenuItemForm" model="Model" />

            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-primary">Spara</button>
                <a class="btn btn-outline-secondary" asp-action="Index">Avbryt</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}